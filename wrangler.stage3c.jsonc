{
  "name": "team-manager-stage3c",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "preview_urls": false,
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist-stage3c",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "STAGE3C_MODE": "management-only"
  }
}
